# systemd quadlet unit. Alternative deployment: compose.yaml.
# Don't run both — same container names and host ports.

[Unit]
Description=OpenTTD Dedicated Server
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/openttd-server:latest
ContainerName=openttd
Network=openttd.network
PublishPort=3979:3979/tcp
PublishPort=3979:3979/udp
Volume=%h/source/dedicatedservers/openttd/data:/data
GIDMap=+g1000:@1000:1
PodmanArgs=--umask=0002

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
